# frontend/Dockerfile.dev
FROM node:20-alpine

WORKDIR /app

# Instalar dependencias
COPY package*.json ./
RUN npm install

# Copiar código fuente
COPY . .

# Comando de desarrollo
CMD ["npm", "run", "dev"]

# Variable de entorno para el backend
ENV NEXT_PUBLIC_API_URL=http://localhost:3000

# Comando de desarrollo
CMD ["npm", "run", "dev"]